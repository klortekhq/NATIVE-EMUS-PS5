diff --git a/Common/CPUDetect.cpp b/Common/CPUDetect.cpp
--- a/Common/CPUDetect.cpp
+++ b/Common/CPUDetect.cpp
@@ -30,6 +30,8 @@
 #include <fcntl.h>
 #elif PPSSPP_PLATFORM(MAC)
 #include <sys/sysctl.h>
+#elif PPSSPP_PLATFORM(PS5)
+#include <unistd.h>
 #endif
@@ -465,6 +467,25 @@ void CPUInfo::Detect() {
 			logical_cpu_count = num / std::max(num_cores, 1);
 		}
 	}
+#elif PPSSPP_PLATFORM(PS5)
+	{
+		long online = sysconf(_SC_NPROCESSORS_ONLN);
+		if (online > 0) {
+			num_cores = (int)online;
+			if (max_ex_fn >= 0x80000008) {
+				do_cpuid(cpu_id, 0x80000008);
+				const int physical = (cpu_id[2] & 0xFF) + 1;
+				if (physical > 0 && physical <= online)
+					num_cores = physical;
+			}
+			logical_cpu_count = (int)(online / std::max(num_cores, 1));
+		}
+	}
 #endif

