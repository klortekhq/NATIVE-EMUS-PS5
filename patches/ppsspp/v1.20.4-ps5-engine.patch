diff --git a/Common/MemArenaPosix.cpp b/Common/MemArenaPosix.cpp
--- a/Common/MemArenaPosix.cpp
+++ b/Common/MemArenaPosix.cpp
@@ -51,7 +51,22 @@ bool MemArena::NeedsProbing() {
 	return false;
 }
+#if PPSSPP_PLATFORM(PS5)
+static void *ps5_reserved = nullptr;
+static const size_t ps5_reserved_bytes = 0x100000000ULL;
+static bool ps5_in_reserved(const void *view, size_t size) {
+	const uintptr_t at = (uintptr_t)view, base = (uintptr_t)ps5_reserved;
+	return ps5_reserved && at >= base && at + size <= base + ps5_reserved_bytes;
+}
+#endif
 
 bool MemArena::GrabMemSpace(size_t size) {
+#if PPSSPP_PLATFORM(PS5)
+	const int result = ps5rt_shm_create(size, &shm_);
+	if (result != 0) return false;
+	return true;
+#endif
@@ -104,6 +119,10 @@ bool MemArena::GrabMemSpace(size_t size) {
 }
 void MemArena::ReleaseSpace() {
+#if PPSSPP_PLATFORM(PS5)
+	ps5rt_shm_destroy(&shm_);
+	return;
+#endif
@@ -111,6 +130,14 @@ void MemArena::ReleaseSpace() {
 void *MemArena::CreateView(s64 offset, size_t size, void *base)
 {
+#if PPSSPP_PLATFORM(PS5)
+	void *view = nullptr;
+	const int result = ps5rt_shm_map(&shm_, (size_t)offset, size, base,
+		PS5RT_SHM_READ | PS5RT_SHM_WRITE, base ? PS5RT_SHM_FIXED : 0, &view);
+	return result == 0 ? view : nullptr;
+#endif
@@ -130,6 +157,33 @@ void *MemArena::CreateView(s64 offset, void* view, size_t size) {
 }
 void MemArena::ReleaseView(s64 offset, void* view, size_t size) {
+#if PPSSPP_PLATFORM(PS5)
+	(void)offset;
+	ps5rt_shm_unmap(view, size, ps5_in_reserved(view, size) ? PS5RT_SHM_KEEP_RESERVED : 0);
+	return;
+#endif
@@ -139,6 +193,25 @@ void *MemArena::ReleaseView(s64 offset, void* view, size_t size) {
 u8* MemArena::Find4GBBase() {
+#if PPSSPP_PLATFORM(PS5)
+	if (!ps5_reserved) {
+		void *const hint = (void *)0x600000000ULL;
+		void *address = nullptr;
+		int result = ps5rt_vrange_reserve(ps5_reserved_bytes, hint, 0x10000, &address);
+		if (result == 0 && address != hint) {
+			ps5rt_vrange_release(address, ps5_reserved_bytes);
+			ps5rt_vrange_release(hint, ps5_reserved_bytes);
+			result = ps5rt_vrange_reserve(ps5_reserved_bytes, hint, 0x10000, &address);
+		}
+		if (result != 0) return nullptr;
+		ps5_reserved = address;
+	}
+	return static_cast<u8 *>(ps5_reserved);
+#endif

diff --git a/Common/MemoryUtil.cpp b/Common/MemoryUtil.cpp
--- a/Common/MemoryUtil.cpp
+++ b/Common/MemoryUtil.cpp
@@ -43,6 +43,9 @@
 #ifndef _WIN32
 #include <unistd.h>
+#if PPSSPP_PLATFORM(PS5)
+#include <ps5rt/c/exec.h>
+#endif
 #endif
@@ -189,7 +192,16 @@ void *AllocateExecutableMemory(size_t size) {
 	if (PlatformIsWXExclusive())
 		prot = PROT_READ | PROT_WRITE;
+#if PPSSPP_PLATFORM(PS5)
+	(void)map_hint;
+	void *ptr = ps5rt_exec_allocate(size, (uintptr_t)&AllocateExecutableMemory);
+	if (!ptr)
+		ptr = MAP_FAILED;
+#else
 	void* ptr = mmap(map_hint, size, prot, MAP_ANON | MAP_PRIVATE, -1, 0);
+#endif
@@ -276,6 +288,12 @@ void FreeMemoryPages(void *ptr, size_t size) {
 }
 void FreeExecutableMemory(void *ptr, size_t size) {
+#if PPSSPP_PLATFORM(PS5)
+	(void)size;
+	if (ptr) { ps5rt_exec_release(ptr); return; }
+#endif
 	FreeMemoryPages(ptr, size);
 }

